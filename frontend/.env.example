# Base URL of the Flask REST API (versioned). Leave USE_MOCK=true until the
# backend is available; every api/* module reads mock data locally when true.
VITE_API_URL=http://localhost:5000/api/v1
VITE_USE_MOCK=true

# Optional: once a real Cloudinary cloud is connected, images resolve to
# real f_auto,q_auto delivery URLs instead of local placeholder art.
VITE_CLOUDINARY_CLOUD_NAME=
