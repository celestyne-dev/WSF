# Base URL of the Flask REST API (versioned). Leave USE_MOCK=true until the
# backend is available; every api/* module reads mock data locally when true.
VITE_API_URL=http://localhost:5000/api/v1
VITE_USE_MOCK=true

# Optional: once the Flask media service is live on the Hostinger VPS,
# point this at its public media root (e.g. https://womenshapingfutures.org/media)
# and images resolve to real WebP delivery URLs instead of local placeholder art.
VITE_MEDIA_BASE_URL=

# Production build (see DEPLOYMENT.md) uses real values along these lines —
# VITE_USE_MOCK=false is the production expectation; real mode never falls
# back to mock data on a failed request (see api/*.js's own error handling):
#   VITE_API_URL=https://womenshapingfutures.org/api/v1
#   VITE_USE_MOCK=false
#   VITE_MEDIA_BASE_URL=https://womenshapingfutures.org/media
