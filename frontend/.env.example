# Base URL of the Flask REST API (versioned). Leave USE_MOCK=true until the
# backend is available; every api/* module reads mock data locally when true.
VITE_API_URL=http://localhost:5000/api/v1
VITE_USE_MOCK=true

# Optional: once the Flask media service is live on the Hostinger VPS,
# point this at its public media root (e.g. /media in production, see below)
# and images resolve to real WebP delivery URLs instead of local placeholder art.
VITE_MEDIA_BASE_URL=

# VITE_USE_MOCK is fail-closed (api/client.js): mock mode only turns on for
# the exact string "true". Unset, empty, misspelled, or "false" all mean
# "use the real backend" — there is no unsafe default to worry about here,
# but a production build should still set it explicitly for clarity.
#
# Production build (see DEPLOYMENT.md) uses real, same-origin values —
# Nginx proxies /api/v1 and /media to Flask/the filesystem from the same
# domain the frontend is served from, so these are root-relative, not
# absolute URLs (api/client.js and utils/media.js both already fall back to
# this same-origin shape when the var is unset — setting it explicitly here
# is just about being unambiguous in the deploy's own .env, not required for
# correctness):
#   VITE_API_URL=/api/v1
#   VITE_USE_MOCK=false
#   VITE_MEDIA_BASE_URL=/media
#
# Set these in frontend/.env.production (loaded automatically by `npm run
# build`, which runs in Vite's "production" mode) rather than frontend/.env,
# and make sure no frontend/.env.local exists on the build machine —
# .env.local is loaded in EVERY mode, including production builds, and
# overrides .env but is itself overridden by .env.production. See Module 5's
# report for the full precedence order.
