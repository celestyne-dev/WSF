FLASK_CONFIG=development
# Required in production — no default is provided for ProductionConfig
# (see config.py:require_production_settings). Generate with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`. Development/
# testing fall back to a clearly-fake placeholder if left blank, so this
# only needs a real value for FLASK_CONFIG=production.
SECRET_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/wsf_dev
# Used only when FLASK_CONFIG=testing (pytest) — a separate database so
# tests can freely create/drop tables without touching wsf_dev.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/wsf_test
# Required in production, same as SECRET_KEY above — 32+ bytes.
JWT_SECRET_KEY=

# Media storage on the Hostinger VPS filesystem (see app/services/media.py).
# MEDIA_ROOT is an absolute path outside the frontend/backend source trees;
# Nginx is configured to serve MEDIA_URL directly from MEDIA_ROOT so Flask
# is never in the hot path of delivering an image to a visitor.
MEDIA_ROOT=/var/www/womenshapingfutures/media
MEDIA_URL=/media/
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000/api/v1
# The canonical public domain — not yet read by any backend module, kept
# here so it's documented in one place for whichever future feature
# (sitemap/RSS/canonical URLs) needs it, rather than being invented ad hoc.
PUBLIC_SITE_URL=https://womenshapingfutures.org

# Comma-separated list of exact origins allowed to call the API with
# credentials. Falls back to FRONTEND_URL (single origin) when unset — set
# this explicitly in production to something like
# "https://womenshapingfutures.org,https://www.womenshapingfutures.org".
# Never include a localhost/127.0.0.1 origin here in production —
# config.py's require_production_settings() refuses to start if you do.
CORS_ORIGINS=

# Plain stdlib logging level name (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO

# Number of reverse proxies actually in front of this app (see
# app/__init__.py's ProxyFix setup). The documented architecture
# (Nginx -> Gunicorn, nothing else in between) is exactly 1 in production;
# leave at 0 for local `flask run`, where nothing proxies the request.
TRUSTED_PROXY_COUNT=0

# Outbound email (see app/services/email.py) — used by password recovery.
# "console" logs the email instead of sending it; safe for local dev only
# — config.py:require_production_settings refuses to start with this
# backend in production. Set EMAIL_BACKEND=smtp and fill in the rest to
# actually send mail locally too, if you want to test against a real
# relay. Never put any of these in a frontend VITE_ env file.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# "true" or "false". Almost every provider/relay expects STARTTLS on 587.
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Women Shaping Futures

GOOGLE_ANALYTICS_ID=
META_PIXEL_ID=
LINKEDIN_INSIGHT_TAG_ID=
