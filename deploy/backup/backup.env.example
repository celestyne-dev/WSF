# /etc/womenshapingfutures/backup.env  (owner root, chmod 600)
# Read by deploy/backup/wsf-backup.sh and wsf-restore-test.sh. Never commit
# the real file. No password belongs in the scripts or on a command line.

# Database to back up (libpq variables). Put the password in
# /root/.pgpass (chmod 600) rather than here, e.g.
#   127.0.0.1:5432:womenshapingfutures:wsf_backup:<password>
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=wsf_backup
PGDATABASE=womenshapingfutures

# What is needed to restore the application besides the database.
MEDIA_ROOT=/var/lib/womenshapingfutures/media
PROTECTED_MEDIA_ROOT=/var/lib/womenshapingfutures/protected_media
APP_ENV_FILE=/var/www/womenshapingfutures/backend/.env

# Encryption: PUBLIC age key(s) only (one per line). The matching private
# key stays OFF the VPS (password manager / offline storage).
AGE_RECIPIENTS_FILE=/etc/womenshapingfutures/backup-recipients.txt

# Off-site storage: an rclone remote configured in /root/.config/rclone/rclone.conf
# (chmod 600) for a provider/bucket that is NOT on this VPS.
RCLONE_REMOTE=wsfoffsite:wsf-backups

# Retention (number of backups kept).
DAILY_KEEP=30
MONTHLY_KEEP=12

# Re-download the uploaded file and compare its SHA-256 (1 = yes).
VERIFY_DOWNLOAD=1

# Restore tests only (wsf-restore-test.sh), on the machine that runs them:
# AGE_IDENTITY_FILE=/root/wsf-backup-identity.txt   # PRIVATE key, remove after the test
# EXPECTED_ALEMBIC_HEAD=<current head revision>
# BACKEND_DIR=/var/www/womenshapingfutures/backend
