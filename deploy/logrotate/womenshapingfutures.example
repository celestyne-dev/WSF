# Women Shaping Futures: application-controlled log files, kept 90 days
# (Step 17 retention). Install as /etc/logrotate.d/womenshapingfutures.
# Covers the maintenance cron log (DEPLOYMENT.md §16) and, if GUNICORN_*_LOG
# point at files instead of journald, the gunicorn logs.
/var/log/womenshapingfutures/*.log {
    daily
    rotate 90
    maxage 90
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root root
}
